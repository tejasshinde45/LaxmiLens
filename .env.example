# LaxmiLens Environment Variables
# Copy this file to .env for local development

# ==============================================================================
# Supabase Configuration
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# Frontend environment variables prefixed with VITE_ are embedded into the client
# bundle and publicly visible in user browsers.
# 
# NEVER put your Supabase service_role key, database passwords, or server-side
# secrets into this file or any .env file in this repository.
#
# Use ONLY the public Anonymous/Publishable key here. Row Level Security (RLS)
# ensures data isolation in the database.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here
# Optional alias supported by Supabase v2+:
# VITE_SUPABASE_PUBLISHABLE_KEY=your-public-anon-key-here

# Application Environment ('development' | 'staging' | 'production' | 'test')
VITE_APP_ENV=development

# Feature Flags
VITE_ENABLE_MOCK_SYNC=true
